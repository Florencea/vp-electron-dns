{
  "name": "vp-electron-dns",
  "version": "1.0.0",
  "private": true,
  "description": "DNS and DoH benchmarking tool",
  "author": "Florencea Bear",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "agent:lint:ci": "actionlint",
    "agent:lint:fix": "vp check --fix && node scripts/lint-tailwind.ts --fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "node scripts/smoke-test.ts",
    "agent:test:unit": "vp test run --reporter=tap-flat --no-color",
    "agent:verify:gate": "vpr agent:verify:unit && vpr build:all && vpr app:pack && vpr agent:test:e2e",
    "agent:verify:inner": "vp check && node scripts/lint-tailwind.ts",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "app:linux": "vpr build:all && vpx electron-forge make --platform=linux",
    "app:mac": "vpr build:all && vpx electron-forge make --platform=darwin",
    "app:pack": "vpr build:all && vpx electron-forge package",
    "app:win": "vpr build:all && vpx electron-forge make --platform=win32 --arch=x64",
    "build": "vpr build:all",
    "build:all": "vp build --mode main && vp build --mode preload && vp build",
    "check:deadcode": "knip",
    "test:setup": "playwright install chromium"
  },
  "devDependencies": {
    "@adobe/react-spectrum": "3.47.7",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "electron": "44.7.2",
    "knip": "6.41.0",
    "oxc-transform-react": "0.154.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vscode-languageserver-protocol": "3.18.4",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.22.0"
  },
  "knip": {
    "entry": [
      "src/main/index.ts",
      "src/preload/index.ts",
      "forge.config.ts"
    ],
    "ignoreBinaries": [
      "actionlint",
      "vpx"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server",
      "@electron-forge/cli"
    ],
    "playwright": true
  }
}
