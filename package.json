{
  "name": "vp-electron-dns",
  "version": "1.0.0",
  "private": true,
  "description": "DNS and DoH benchmarking tool",
  "author": "Florencea Bear",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "agent:lint:ci": "actionlint",
    "agent:lint:fix": "vp check --fix && node scripts/lint-tailwind.ts --fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "node scripts/smoke-test.ts",
    "agent:test:unit": "vp test run --reporter=tap-flat --no-color",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build:all && npm run app:pack && npm run agent:test:e2e",
    "agent:verify:inner": "vp check && node scripts/lint-tailwind.ts",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "app:linux": "npm run build:all && electron-forge make --platform=linux",
    "app:mac": "npm run build:all && electron-forge make --platform=darwin",
    "app:pack": "npm run build:all && electron-forge package",
    "app:win": "npm run build:all && electron-forge make --platform=win32 --arch=x64",
    "build": "npm run build:all",
    "build:all": "vp build --mode main && vp build --mode preload && vp build",
    "check": "vp check",
    "check:deadcode": "knip",
    "dev": "vp dev",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:ci": "actionlint",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "test": "vp test run",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run agent:verify:inner && npm run check:deadcode && npm run agent:test:unit && npm run build:all && npm run app:pack && npm run agent:test:e2e"
  },
  "devDependencies": {
    "@adobe/react-spectrum": "3.47.7",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "electron": "45.4.1",
    "knip": "6.46.1",
    "oxc-transform-react": "0.156.0",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "vscode-languageserver-protocol": "3.18.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  },
  "knip": {
    "entry": [
      "src/main/index.ts",
      "src/preload/index.ts",
      "forge.config.ts"
    ],
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
